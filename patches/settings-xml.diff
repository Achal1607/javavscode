+    public void setUserSettingsXml(String path) {
+      String normalized = path != null ? path.trim() : "";
+      String old = getPreferences().get(PROP_USER_SETTINGS_XML, "");
+
+      if (old.equals(normalized)) {
+          return;
+      }
