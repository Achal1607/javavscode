+package org.netbeans.modules.java.lsp.server.notebook;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.logging.Logger;
+import org.apache.maven.artifact.Artifact;
+import org.apache.maven.execution.MavenExecutionRequest;
+import org.apache.maven.project.ProjectBuildingRequest;
+import org.apache.maven.project.ProjectBuildingResult;
+import org.eclipse.aether.transfer.AbstractTransferListener;
+import org.eclipse.aether.transfer.TransferEvent;
+import org.eclipse.aether.transfer.TransferResource;
+import org.netbeans.modules.maven.embedder.EmbedderFactory;
+import org.netbeans.modules.maven.embedder.MavenEmbedder;
+
+public class NotebookDependencyHandler {
+
+    private static final Logger LOG = Logger.getLogger(NotebookDependencyHandler.class.getName());
+
+    private final MavenEmbedder embedder;
+
+    private NotebookDependencyHandler() {
+        this.embedder = EmbedderFactory.getOnlineEmbedder();
+    }
+
+    private static class Holder {
+
+        static final NotebookDependencyHandler INSTANCE = new NotebookDependencyHandler();
+    }
+
+    public static NotebookDependencyHandler getInstance() {
+        return Holder.INSTANCE;
+    }
+    
+    public List<File> resolveTransitiveDependencies(String gavCoords) throws Exception {
+        return resolveTransitiveDependencies(gavCoords, null);
+    }
+
+    public List<File> resolveTransitiveDependencies(String gavCoords, Consumer<String> progressCallback) throws Exception {
+        String[] parts = gavCoords.split(":");
+        if (parts.length < 3) {
+            throw new IllegalArgumentException("Invalid GAV format. Expected g:a:v");
+        }
+        String groupId = parts[0];
+        String artifactId = parts[1];
+        String version = parts[2];
+
+        Artifact rootArtifact = embedder.createProjectArtifact(groupId, artifactId, version);
+
+        MavenExecutionRequest executionRequest = embedder.createMavenExecutionRequest();
+        MyDownloadListener listener = null;
+        if(progressCallback != null){
+            listener = new MyDownloadListener(progressCallback);
+            executionRequest.setTransferListener(listener);
+        }
+
+        ProjectBuildingRequest buildingRequest = executionRequest.getProjectBuildingRequest();
+        buildingRequest.setResolveDependencies(true);
+        ProjectBuildingResult result;
+        
+        if(listener != null){
+            result = embedder.buildProject(rootArtifact, buildingRequest, listener);
+        } else {
+            result = embedder.buildProject(rootArtifact, buildingRequest);
+        }
+
+        Set<Artifact> resolvedArtifacts = result.getProject().getArtifacts();
+
+        List<File> jars = new ArrayList<>();
+        if (rootArtifact.getFile() != null) {
+            jars.add(rootArtifact.getFile());
+        }
+        for (Artifact a : resolvedArtifacts) {
+            if (a.getFile() != null) {
+                jars.add(a.getFile());
+            }
+        }
+
+        return jars;
+    }
+
+    private static class MyDownloadListener extends AbstractTransferListener {
+
+        private final java.util.function.Consumer<String> progressCallback;
+
+        public MyDownloadListener(Consumer<String> progressCallback) {
+            this.progressCallback = progressCallback;
+        }
+
+        private void publish(String message) {
+            if (progressCallback != null) {
+                progressCallback.accept(message);
+            }
+        }
+
+        @Override
+        public void transferStarted(TransferEvent event) {
+            publish("Downloading: " + event.getResource().getResourceName() + "\n");
+        }
+
+        @Override
+        public void transferProgressed(TransferEvent event) {
+            TransferResource resource = event.getResource();
+            long downloaded = event.getTransferredBytes();
+            long total = resource.getContentLength();
+
+            if (total > 0) {
+                double percent = (double) downloaded / total * 100;
+                publish(String.format("Progress [%s]: %.2f%%\n", resource.getResourceName(), percent));
+            }
+        }
+
+        @Override
+        public void transferSucceeded(TransferEvent event) {
+            publish("Finished: " + event.getResource().getResourceName() + "\n");
+        }
+
+        @Override
+        public void transferFailed(TransferEvent event) {
+            publish("Failed to download: " + event.getResource().getResourceName() + "\n");
+        }
+    }
+}
